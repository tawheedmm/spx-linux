#!/bin/bash
# spx-boot: boot setup for Linux on the Microsoft Surface Pro X (SQ1).
#
# Kernels stay on the Linux root filesystem (/boot). Only a small standalone GRUB image and a
# generated grub.cfg live on the EFI system partition (shared with Windows), in \EFI\spx.
#
#   spx-boot install [--yes] [--adopt] [--make-default] [--dry-run] [--test]
#                                  one-time setup; asks before touching the ESP or UEFI boot entries.
#                                  --test: install to \EFI\spx-test with a separate UEFI entry that
#                                  is used for the next boot only (BootNext); kernels get spx.test=1;
#                                  the kernel hooks stay off. For trying spx-boot next to a setup.
#   spx-boot update                regenerate \EFI\spx\grub.cfg (run by the kernel hooks; does
#                                  nothing until "install" has been run)
#   spx-boot remove [--test] [--yes]  remove what install added (UEFI entry, \EFI\spx[-test] files)
#   spx-boot status                show what is set up
#   spx-boot print-config          print the grub.cfg that "update" would write
#
# Package install/upgrade scripts never call "install". Only you do.
set -euo pipefail

VERSION=0.1
P=${SPX_PREFIX:-}                       # test prefix; empty on a real system
DEFAULTS=$P/etc/default/spx-boot
STATE=$P/var/lib/spx-boot/state
LIBDIR=${SPX_LIBDIR:-$P/usr/lib/spx-boot}
BOOT=$P/boot
ESP_GUID=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
MARKER="# generated by spx-boot"
EFIDIR=${SPX_EFIDIR:-spx}                # \EFI\<dir> on the ESP; "spx-test" with --test
LABEL="SPX Linux"
loader() { printf '\\EFI\\%s\\grubaa64.efi' "$EFIDIR"; }
use_test_mode() {
  EFIDIR=spx-test; LABEL="SPX Linux (spx-boot test)"; STATE=$P/var/lib/spx-boot/state-test
  SPX_CMDLINE_EXTRA="$SPX_CMDLINE_EXTRA spx.test=1"
}

# defaults; /etc/default/spx-boot overrides them
SPX_TIMEOUT=3
SPX_KEEP=2
SPX_CMDLINE_BASE="efi=novamap clk_ignore_unused deferred_probe_timeout=60 fw_devlink.sync_state=timeout ssbd=force-on"
SPX_CMDLINE_EXTRA="quiet"
SPX_DTB=""                               # empty = choose from the device-tree compatible
SPX_SAFE_MODE=yes
[ -r "$DEFAULTS" ] && . "$DEFAULTS"

log()  { echo "spx-boot: $*" >&2; }
die()  { log "error: $*"; exit 1; }
need_root() { [ -n "$P" ] || [ "$(id -u)" = 0 ] || die "run as root (sudo spx-boot $1)"; }

# ---------- detection ----------
dt_compatible() { tr '\0' '\n' < "${SPX_DT:-/proc/device-tree}/compatible" 2>/dev/null || true; }

detect_dtb() {
  [ -n "$SPX_DTB" ] && { echo "$SPX_DTB"; return; }
  local c; c=$(dt_compatible)
  case "$c" in
    *microsoft,cambria*) echo sc8180x-microsoft-cambria.dtb ;;   # SQ1 with LTE (tested)
    *microsoft,caspar*)  echo sc8180x-microsoft-caspar.dtb ;;    # SQ1 without modem (untested)
    *microsoft,carina*)  echo sc8180x-microsoft-carina.dtb ;;    # SQ2 (out of scope, untested)
    *) echo "" ;;
  esac
}

root_uuid() {
  [ -n "${SPX_ROOT_UUID:-}" ] && { echo "$SPX_ROOT_UUID"; return; }
  findmnt -no UUID /
}

boot_on_root() {
  [ -n "$P" ] && return 0
  [ "$(findmnt -no SOURCE /boot 2>/dev/null || true)" = "" ] || \
  [ "$(findmnt -no SOURCE /boot)" = "$(findmnt -no SOURCE /)" ]
}

is_uncompressed_image() { [ "$(head -c2 "$1" 2>/dev/null)" = "MZ" ]; }

# Bootable kernels, newest first: uncompressed Image + initrd + DTB present
list_kernels() {
  local dtb=$1 rel
  for v in "$BOOT"/vmlinuz-*; do
    [ -e "$v" ] || continue
    rel=${v##*/vmlinuz-}
    if ! is_uncompressed_image "$v"; then log "skipping $rel: not an uncompressed EFI Image (GRUB on arm64 can't load Image.gz)"; continue; fi
    [ -e "$BOOT/initrd.img-$rel" ] || { log "skipping $rel: no initrd.img-$rel"; continue; }
    [ -e "$P/usr/lib/linux-image-$rel/qcom/$dtb" ] || { log "skipping $rel: no $dtb in /usr/lib/linux-image-$rel/qcom"; continue; }
    echo "$rel"
  done | sort -rV | head -n "$SPX_KEEP"
}

# ---------- grub.cfg ----------
entry() {  # $1 title, $2 release, $3 dtb, $4 uuid, $5 extra cmdline
  cat <<EOF
menuentry "$1" {
    insmod part_gpt
    insmod ext2
    search --no-floppy --fs-uuid $4 --set=root
    devicetree /usr/lib/linux-image-$2/qcom/$3
    linux /boot/vmlinuz-$2 root=UUID=$4 rw rootwait $SPX_CMDLINE_BASE $5
    initrd /boot/initrd.img-$2
}
EOF
}

gen_config() {
  local dtb uuid kernels first=1 rel
  dtb=$(detect_dtb); [ -n "$dtb" ] || die "unknown machine (device-tree compatible: $(dt_compatible | tr '\n' ' ')); set SPX_DTB in $DEFAULTS"
  uuid=$(root_uuid); [ -n "$uuid" ] || die "can't find the root filesystem UUID"
  kernels=$(list_kernels "$dtb")
  [ -n "$kernels" ] || die "no bootable kernel in /boot (need vmlinuz-*, initrd.img-* and the DTB)"
  cat <<EOF
$MARKER $VERSION. Do not edit: changes are overwritten on every kernel install.
# Settings: /etc/default/spx-boot. Regenerate: sudo spx-boot update
set timeout=$SPX_TIMEOUT
set default=0
insmod part_gpt
insmod fat
search --no-floppy --file /EFI/$EFIDIR/grub.cfg --set=root
set spx=/EFI/$EFIDIR

# one-shot boot (spx-boot-once style): next_entry in \EFI\spx\grubenv
if [ -f \$spx/grubenv ]; then
    load_env --file \$spx/grubenv next_entry
    if [ -n "\$next_entry" ]; then
        set default="\$next_entry"
        set next_entry=
        save_env --file \$spx/grubenv next_entry
    fi
fi

EOF
  for rel in $kernels; do
    if [ $first = 1 ]; then
      entry "SPX Linux" "$rel" "$dtb" "$uuid" "$SPX_CMDLINE_EXTRA"
      first=0; newest=$rel
    else
      entry "SPX Linux (previous kernel $rel)" "$rel" "$dtb" "$uuid" "$SPX_CMDLINE_EXTRA"
    fi
  done
  if [ "$SPX_SAFE_MODE" = yes ]; then
    entry "SPX Linux (safe mode: no GPU/touch/cover/DSP drivers)" "$newest" "$dtb" "$uuid" \
      "loglevel=7 modprobe.blacklist=msm,spi_hid_of,spi_hid,surface_aggregator,qcom_q6v5_pas systemd.unit=multi-user.target"
  fi
  cat <<'EOF'
menuentry "Windows" {
    insmod fat
    search --no-floppy --file /EFI/Microsoft/Boot/bootmgfw.efi --set=root
    chainloader /EFI/Microsoft/Boot/bootmgfw.efi
}
menuentry "UEFI firmware settings" {
    fwsetup
}
EOF
}

# ---------- ESP handling ----------
ESP_MNT=""; ESP_MOUNTED_BY_US=0
cleanup() { if [ "$ESP_MOUNTED_BY_US" = 1 ]; then umount "$ESP_MNT" 2>/dev/null || true; rmdir "$ESP_MNT" 2>/dev/null || true; fi; }
trap cleanup EXIT

find_esp_partuuid() {  # prefer the ESP that holds the Windows boot manager
  local cand="" path pt fs pu m
  while read -r path pt fs pu; do
    [ "$pt" = "$ESP_GUID" ] && [ "$fs" = vfat ] || continue
    m=$(mount_esp_ro_check "$path")
    if [ -n "$m" ]; then echo "$pu"; return; fi
    [ -n "$cand" ] || cand=$pu
  done < <(lsblk -rno PATH,PARTTYPE,FSTYPE,PARTUUID)
  echo "$cand"
}
mount_esp_ro_check() {  # prints "yes" if this partition has \EFI\Microsoft\Boot\bootmgfw.efi
  local dev=$1 t m
  m=$(findmnt -rno TARGET -S "$dev" | head -1 || true)
  if [ -n "$m" ]; then [ -f "$m/EFI/Microsoft/Boot/bootmgfw.efi" ] && echo yes; return 0; fi
  t=$(mktemp -d); if mount -o ro "$dev" "$t" 2>/dev/null; then
    [ -f "$t/EFI/Microsoft/Boot/bootmgfw.efi" ] && echo yes; umount "$t"; fi; rmdir "$t"
}

mount_esp() {  # $1 = partuuid; sets ESP_MNT (read-write)
  if [ -n "${SPX_ESP:-}" ]; then ESP_MNT=$SPX_ESP; return; fi
  local dev; dev=$(blkid -t PARTUUID="$1" -o device 2>/dev/null | head -1)
  [ -n "$dev" ] || die "ESP with PARTUUID $1 not found"
  ESP_MNT=$(findmnt -rno TARGET -S "$dev" -O rw | head -1 || true)
  # a bind mount of a subdirectory (e.g. /boot/efi -> \EFI\spx) isn't the ESP root: mount it ourselves
  if [ -z "$ESP_MNT" ] || [ ! -d "$ESP_MNT/EFI" ]; then
    ESP_MNT=$(mktemp -d /run/spx-boot-esp.XXXXXX); mount -o rw,umask=0077 "$dev" "$ESP_MNT"; ESP_MOUNTED_BY_US=1
  fi
}

write_config() {  # atomically replace \EFI\spx\grub.cfg, keep the previous one
  local d=$ESP_MNT/EFI/$EFIDIR new
  new=$(gen_config) || exit 1
  mkdir -p "$d"
  if [ -f "$d/grub.cfg" ] && [ "$(cat "$d/grub.cfg")" = "$new" ]; then log "grub.cfg unchanged"; return; fi
  printf '%s\n' "$new" > "$d/grub.cfg.new"
  [ -f "$d/grub.cfg" ] && cp -p "$d/grub.cfg" "$d/grub.cfg.prev"
  mv -f "$d/grub.cfg.new" "$d/grub.cfg"; sync
  log "wrote $d/grub.cfg ($(grep -c '^menuentry' "$d/grub.cfg") entries)"
}

# ---------- commands ----------
cmd_print_config() { gen_config; }

cmd_update() {
  [ -f "$STATE" ] || exit 0          # not set up: kernel hooks stay silent
  need_root update
  . "$STATE"
  mount_esp "$ESP_PARTUUID"
  write_config
}

cmd_status() {
  echo "spx-boot $VERSION"
  echo "machine: $(dt_compatible | head -1)  dtb: $(detect_dtb)"
  echo "kernels that would get an entry: $(list_kernels "$(detect_dtb)" 2>/dev/null | tr '\n' ' ')"
  if [ -f "$STATE" ]; then . "$STATE"; echo "installed: yes (ESP PARTUUID $ESP_PARTUUID, since $INSTALLED)"; else echo "installed: no (run: sudo spx-boot install)"; fi
  command -v efibootmgr >/dev/null && [ -z "$P" ] && efibootmgr 2>/dev/null | grep -iE "BootOrder|SPX" || true
}

cmd_install() {
  local yes=0 adopt=0 makedef=0 dry=0 test=0
  for a in "$@"; do case $a in --yes) yes=1;; --adopt) adopt=1;; --make-default) makedef=1;; --dry-run) dry=1;; --test) test=1;; *) die "unknown option $a";; esac; done
  if [ $test = 1 ]; then use_test_mode; [ $makedef = 0 ] || die "--test and --make-default don't go together"; fi
  need_root install
  [ -n "$P" ] || [ -d /sys/firmware/efi ] || die "not booted via UEFI"
  case "$(dt_compatible)" in
    *microsoft,cambria*) ;;
    *microsoft,caspar*) log "warning: Surface Pro X SQ1 without modem: untested, please report results" ;;
    *) [ -n "$SPX_DTB" ] || die "this doesn't look like a Surface Pro X SQ1 ($(dt_compatible | head -1)). Set SPX_DTB in $DEFAULTS to override" ;;
  esac
  boot_on_root || die "/boot is a separate filesystem; spx-boot needs /boot on the root filesystem"
  local cfg; cfg=$(gen_config) || exit 1
  [ -f "$LIBDIR/grubaa64.efi" ] || die "missing $LIBDIR/grubaa64.efi"

  local pu="${SPX_ESP_PARTUUID:-}"
  [ -n "$pu" ] || [ -n "${SPX_ESP:-}" ] || pu=$(find_esp_partuuid)
  [ -n "$pu" ] || [ -n "${SPX_ESP:-}" ] || die "no EFI system partition found"
  mount_esp "${pu:-test}"
  local d=$ESP_MNT/EFI/$EFIDIR existing=no
  if [ -e "$d/grub.cfg" ] && ! head -1 "$d/grub.cfg" | grep -qF "$MARKER"; then
    existing=yes
    [ $adopt = 1 ] || die "$d already contains a grub.cfg not made by spx-boot. Re-run with --adopt to back it up and take over (your current default boot entry will change)"
  fi
  local free; free=$(df -Pk "$ESP_MNT" | awk 'NR==2{print $4}')

  cat <<EOF

spx-boot will:
  - copy the GRUB boot loader to   $d/grubaa64.efi   (about 3 MB; ESP free: $((free/1024)) MB)
  - write the boot menu to         $d/grub.cfg       ($(echo "$cfg" | grep -c '^menuentry') entries, kernels loaded from /boot on the root filesystem)
$( [ $existing = yes ] && echo "  - back up the existing \\EFI\\$EFIDIR files to $d/backup-before-spx-boot/" )
  - back up the UEFI boot variables to /var/lib/spx-boot/
  - add ONE UEFI boot entry "$LABEL" -> $(loader) (if none points there yet)
$( if [ $test = 1 ]; then echo "  - TEST MODE: use that entry for the NEXT BOOT ONLY (BootNext); boot order unchanged; kernel hooks stay off"
   elif [ $makedef = 1 ]; then echo "  - put \"$LABEL\" FIRST in the boot order"
   else echo "  - leave the boot order as it is (pick \"$LABEL\" from the firmware boot menu, or run with --make-default)"; fi )
It will not touch \\EFI\\Microsoft or any other file on the ESP.
EOF
  [ $dry = 1 ] && { echo; echo "(dry run: nothing changed)"; echo "--- grub.cfg ---"; echo "$cfg"; return; }
  if [ $yes = 0 ]; then read -rp "Proceed? Type YES: " ans; [ "$ans" = YES ] || die "cancelled, nothing changed"; fi

  mkdir -p "$d" "$P/var/lib/spx-boot"
  if [ $existing = yes ]; then
    mkdir -p "$d/backup-before-spx-boot"
    for f in grub.cfg grubaa64.efi grubenv; do [ -e "$d/$f" ] && cp -p "$d/$f" "$d/backup-before-spx-boot/"; done
  fi
  cp "$LIBDIR/grubaa64.efi" "$d/grubaa64.efi.new" && mv -f "$d/grubaa64.efi.new" "$d/grubaa64.efi"
  write_config
  # 1024-byte GRUB environment block ("# GRUB Environment Block\n" + '#' padding); no "yes |"
  # pipeline here: under pipefail its SIGPIPE would abort the install
  [ -e "$d/grubenv" ] || { printf '# GRUB Environment Block\n'; head -c 999 /dev/zero | tr '\0' '#'; } > "$d/grubenv"   # 25 + 999 = 1024

  if [ -z "$P" ]; then
    local b=/var/lib/spx-boot/efivars-backup-$(date +%Y%m%d-%H%M%S)
    mkdir -p "$b"; efibootmgr -v > "$b/efibootmgr.txt" 2>&1 || true
    cp -a /sys/firmware/efi/efivars/Boot*-8be4df61-93ca-11d2-aa0d-00e098032b8c "$b/" 2>/dev/null || true
    local num; num=$(entry_num)
    if [ -n "$num" ]; then
      log "a UEFI boot entry for $(loader) already exists (Boot$num); not adding another"
    else
      local order dev disk part
      order=$(efibootmgr | sed -n 's/^BootOrder: //p')
      dev=$(blkid -t PARTUUID="$pu" -o device | head -1)
      disk=/dev/$(lsblk -no PKNAME "$dev"); part=$(cat /sys/class/block/"$(basename "$dev")"/partition)
      efibootmgr -q --create --disk "$disk" --part "$part" --label "$LABEL" --loader "$(loader)"
      num=$(entry_num)
      if [ $makedef = 0 ] && [ -n "$order" ]; then
        efibootmgr -q --bootorder "$order${num:+,$num}"   # efibootmgr puts new entries first; restore the old order
      fi
    fi
    if [ $test = 1 ] && [ -n "$num" ]; then
      efibootmgr -q --bootnext "$num"; log "next boot (once): Boot$num \"$LABEL\""
    fi
  fi
  printf 'ESP_PARTUUID=%s\nINSTALLED=%s\n' "${pu:-test}" "$(date -Is)" > "$STATE"
  if [ $test = 1 ]; then log "test install done. Reboot to try it once; afterwards: sudo spx-boot remove --test"
  else log "done. Kernel installs and removals now update the boot menu automatically."; fi
}

entry_num() {  # Boot#### number of the UEFI entry whose loader is $(loader), if any
  efibootmgr -v 2>/dev/null | grep -iF "$(loader)" | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\).*/\1/p' | head -1
}

cmd_remove() {
  local yes=0 test=0
  for a in "$@"; do case $a in --yes) yes=1;; --test) test=1;; *) die "unknown option $a";; esac; done
  need_root remove
  [ $test = 1 ] && use_test_mode
  [ -f "$STATE" ] || die "nothing to remove (no $STATE)"
  . "$STATE"
  mount_esp "$ESP_PARTUUID"
  local d=$ESP_MNT/EFI/$EFIDIR num=""
  [ -n "$P" ] || num=$(entry_num)
  head -1 "$d/grub.cfg" 2>/dev/null | grep -qF "$MARKER" || die "$d/grub.cfg wasn't made by spx-boot; not removing anything"
  cat <<EOF
spx-boot will remove:
  - $d/{grubaa64.efi,grub.cfg,grub.cfg.prev,grubenv}$( [ -d "$d/backup-before-spx-boot" ] && echo " (your backup in $d/backup-before-spx-boot stays)")
  - the UEFI boot entry ${num:+Boot$num }"$LABEL" -> $(loader)
  - $STATE
EOF
  if [ $yes = 0 ]; then read -rp "Proceed? Type YES: " ans; [ "$ans" = YES ] || die "cancelled, nothing changed"; fi
  [ -n "$num" ] && efibootmgr -q -b "$num" -B
  rm -f "$d/grubaa64.efi" "$d/grub.cfg" "$d/grub.cfg.prev" "$d/grub.cfg.new" "$d/grubenv"
  rmdir "$d" 2>/dev/null || true
  rm -f "$STATE"; sync
  log "removed"
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  update) cmd_update ;;
  status) cmd_status ;;
  print-config) cmd_print_config ;;
  *) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
