From f96651d2934f17fdaefd8a50f6793fdc14c7f2ab Mon Sep 17 00:00:00 2001
From: Tawheed Makhdoomi <_@tawheed.cc>
Date: Fri, 13 Nov 2026 00:28:21 -0500
Subject: [PATCH 27/41] WIP: front camera on CCI1 master 0 (per ACPI CAMP.PCFG)

CAMP.PCFG carries one packed word per sensor; reading the low byte as
CCI core/master gives rear 0/0, front 1/0, IR 1/1. The front sensor timed
out on CCI0 master 1 (the SM8150 MTP guess); try CCI1 master 0.

---
 arch/arm64/boot/dts/qcom/sc8180x-microsoft-surface-pro-x.dtsi | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sc8180x-microsoft-surface-pro-x.dtsi b/arch/arm64/boot/dts/qcom/sc8180x-microsoft-surface-pro-x.dtsi
index 980f90aa1a..917ff14e25 100644
--- a/arch/arm64/boot/dts/qcom/sc8180x-microsoft-surface-pro-x.dtsi
+++ b/arch/arm64/boot/dts/qcom/sc8180x-microsoft-surface-pro-x.dtsi
@@ -490,7 +490,8 @@ &cci0_i2c0 {
 	/* Rear camera module also has a DW9800 VCM and an M24C64 EEPROM (not described) */
 };
 
-&cci0_i2c1 {
+&cci1_i2c0 {
+	/* ACPI CAMP.PCFG: front sensor word 0x00010010 -> CCI1 master 0 */
 	/* Front camera module also has an M24C64 EEPROM (not described) */
 	camera@36 {
 		compatible = "ovti,ov5693";
