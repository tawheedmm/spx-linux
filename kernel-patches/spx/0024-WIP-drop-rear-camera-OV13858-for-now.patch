From 70a46e7f8e1adcc5b0f9a48f864d77be086065da Mon Sep 17 00:00:00 2001
From: Tawheed Makhdoomi <_@tawheed.cc>
Date: Thu, 12 Nov 2026 19:35:48 -0500
Subject: [PATCH 24/41] WIP: drop rear camera (OV13858) for now

Requesting L1A (1.2 V) at regulator registration times out in RPMh
(-110), which fails the whole pmc8180-a regulator device and takes
Wi-Fi's supply (L9A) down with it. Leave L1A/L17A and the rear sensor
out until the right rail is known; front and IR only need L14A.

---
 arch/arm64/boot/dts/qcom/Makefile             |  2 +
 .../qcom/sc8180x-microsoft-surface-pro-x.dtsi | 44 -------------------
 2 files changed, 2 insertions(+), 44 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 84ba824ed7..fc03d827f3 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -325,6 +325,8 @@ dtb-$(CONFIG_ARCH_QCOM)	+= sc7280-idp2.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sc7280-crd-r3.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sc8180x-lenovo-flex-5g.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sc8180x-microsoft-cambria.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= sc8180x-microsoft-cambria-rmtfs.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= sc8180x-microsoft-cambria-nomodem.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sc8180x-microsoft-carina.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sc8180x-microsoft-caspar.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sc8180x-primus.dtb
diff --git a/arch/arm64/boot/dts/qcom/sc8180x-microsoft-surface-pro-x.dtsi b/arch/arm64/boot/dts/qcom/sc8180x-microsoft-surface-pro-x.dtsi
index 3fb64b80ab..662c66703e 100644
--- a/arch/arm64/boot/dts/qcom/sc8180x-microsoft-surface-pro-x.dtsi
+++ b/arch/arm64/boot/dts/qcom/sc8180x-microsoft-surface-pro-x.dtsi
@@ -299,11 +299,6 @@ vreg_s5a_2p04: smps5 {
 		};
 
 		/* Rear camera DVDD (ACPI PEP: CAMS only) */
-		vreg_l1a_1p2: ldo1 {
-			regulator-min-microvolt = <1200000>;
-			regulator-max-microvolt = <1200000>;
-			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
-		};
 
 		vreg_l7a_1p8: ldo7 {
 			regulator-min-microvolt = <1800000>;
@@ -331,11 +326,6 @@ vreg_l14a_1p8: ldo14 {
 		};
 
 		/* Rear camera AVDD (ACPI PEP: CAMS only) */
-		vreg_l17a_2p85: ldo17 {
-			regulator-min-microvolt = <2850000>;
-			regulator-max-microvolt = <2850000>;
-			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
-		};
 	};
 
 	pmc8180-e-rpmh-regulators {
@@ -476,14 +466,6 @@ &camss {
 	status = "okay";
 
 	ports {
-		port@0 {
-			csiphy0_ep: endpoint@0 {
-				reg = <0>;
-				clock-lanes = <7>;
-				data-lanes = <0 1 2 3>;
-				remote-endpoint = <&cam_rear_ep>;
-			};
-		};
 
 		port@2 {
 			csiphy2_ep: endpoint@0 {
@@ -511,32 +493,6 @@ &cci0 {
 
 &cci0_i2c0 {
 	/* Rear camera module also has a DW9800 VCM and an M24C64 EEPROM (not described) */
-	camera@10 {
-		compatible = "ovti,ov13858";
-		reg = <0x10>;
-
-		clocks = <&camcc CAM_CC_MCLK0_CLK>;
-		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
-		assigned-clock-rates = <19200000>;
-
-		reset-gpios = <&tlmm 22 GPIO_ACTIVE_LOW>;
-		pinctrl-0 = <&cam_mclk0_default>, <&cam_rear_default>;
-		pinctrl-names = "default";
-
-		dovdd-supply = <&vreg_l14a_1p8>;
-		avdd-supply = <&vreg_l17a_2p85>;
-		dvdd-supply = <&vreg_l1a_1p2>;
-
-		orientation = <MEDIA_ORIENTATION_BACK>;
-
-		port {
-			cam_rear_ep: endpoint {
-				data-lanes = <1 2 3 4>;
-				link-frequencies = /bits/ 64 <540000000 270000000>;
-				remote-endpoint = <&csiphy0_ep>;
-			};
-		};
-	};
 };
 
 &cci0_i2c1 {
