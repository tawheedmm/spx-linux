+/*
+ * Cameras. From the Windows DSDT (PEP power sequences for \_SB.CAMS/CAMF/CAMI
+ * and the SCFG methods): rear OV13858 at 0x10 (MCLK0, reset GPIO22, L14A +
+ * L17A + L1A), front OV5693 at 0x36 (MCLK2, reset GPIO12, L14A), IR OV7251 at
+ * 0x60 (MCLK3, enable GPIO23, L14A), all with a 19.2 MHz MCLK.
+ *
+ * NOT in the DSDT and therefore GUESSED: which CCI bus/master each sensor is
+ * on and which CSIPHY each one uses. The guess follows Qualcomm's SM8150 MTP
+ * reference slots for MCLK0/2/3: rear CSIPHY0 on CCI0/i2c0, front CSIPHY2 on
+ * CCI0/i2c1, IR CSIPHY3 on CCI1/i2c1. Move the nodes if probing finds them
+ * elsewhere.
+ * The CSIPHY vdda-phy/vdda-pll rails are not voted by Windows either and are
+ * left out (dummy regulators).
+ */
+&camss {
+	status = "okay";
+
+	ports {
+		port@0 {
+			csiphy0_ep: endpoint@0 {
+				reg = <0>;
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&cam_rear_ep>;
+			};
+		};
+
+		port@2 {
+			csiphy2_ep: endpoint@0 {
+				reg = <0>;
+				clock-lanes = <7>;
+				data-lanes = <0 1>;
+				remote-endpoint = <&cam_front_ep>;
+			};
+		};
+
+		port@3 {
+			csiphy3_ep: endpoint@0 {
+				reg = <0>;
+				clock-lanes = <7>;
+				data-lanes = <0>;
+				remote-endpoint = <&cam_ir_ep>;
+			};
+		};
+	};
+};
+
+&cci0 {
+	status = "okay";
+};
+
+&cci0_i2c0 {
+	/* Rear camera module also has a DW9800 VCM and an M24C64 EEPROM (not described) */
+	camera@10 {
+		compatible = "ovti,ov13858";
+		reg = <0x10>;
+
+		clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 22 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_mclk0_default>, <&cam_rear_default>;
+		pinctrl-names = "default";
+
+		dovdd-supply = <&vreg_l14a_1p8>;
+		avdd-supply = <&vreg_l17a_2p85>;
+		dvdd-supply = <&vreg_l1a_1p2>;
+
+		orientation = <MEDIA_ORIENTATION_BACK>;
+
+		port {
+			cam_rear_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <540000000 270000000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
+};
+
+&cci0_i2c1 {
+	/* Front camera module also has an M24C64 EEPROM (not described) */
+	camera@36 {
+		compatible = "ovti,ov5693";
+		reg = <0x36>;
+
+		clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		clock-names = "xvclk";
+		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 12 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_mclk2_default>, <&cam_front_default>;
+		pinctrl-names = "default";
+
+		/* Only DOVDD is switched by Windows; AVDD/DVDD come from elsewhere */
+		dovdd-supply = <&vreg_l14a_1p8>;
+
+		orientation = <MEDIA_ORIENTATION_FRONT>;
+
+		port {
+			cam_front_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <419200000>;
+				remote-endpoint = <&csiphy2_ep>;
+			};
+		};
+	};
+};
+
+&cci1 {
+	status = "okay";
+};
+
+&cci1_i2c1 {
+	camera@60 {
+		compatible = "ovti,ov7251";
+		reg = <0x60>;
+
+		clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		enable-gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>;
+		pinctrl-0 = <&cam_mclk3_default>, <&cam_ir_default>;
+		pinctrl-names = "default";
+
+		/* Only DOVDD is switched by Windows; AVDD/DVDD come from elsewhere */
+		vdddo-supply = <&vreg_l14a_1p8>;
+
+		orientation = <MEDIA_ORIENTATION_FRONT>;
+
+		port {
+			cam_ir_ep: endpoint {
+				data-lanes = <1>;
+				link-frequencies = /bits/ 64 <240000000 319200000>;
+				remote-endpoint = <&csiphy3_ep>;
+			};
+		};
+	};
+};
+
 &dispcc {
 	status = "okay";
 };
