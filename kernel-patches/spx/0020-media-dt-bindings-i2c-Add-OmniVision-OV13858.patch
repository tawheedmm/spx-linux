From 71b213c2318f2c962e2dd9257f80293688d5c09e Mon Sep 17 00:00:00 2001
From: Tawheed Makhdoomi <_@tawheed.cc>
Date: Thu, 12 Nov 2026 15:48:11 -0500
Subject: [PATCH 20/41] media: dt-bindings: i2c: Add OmniVision OV13858

Add a binding for the OmniVision OV13858 13 MP CMOS sensor. The driver has
only probed through ACPI on Intel platforms so far; describe it for DT
platforms (Microsoft Surface Pro X, Qualcomm SC8180X) with its clock, three
supplies, the XSHUTDOWN reset GPIO and a 4-lane CSI-2 endpoint.

Signed-off-by: Tawheed Makhdoomi <_@tawheed.cc>
---
 .../bindings/media/i2c/ovti,ov13858.yaml      | 107 ++++++++++++++++++
 1 file changed, 107 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/ovti,ov13858.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/ovti,ov13858.yaml b/Documentation/devicetree/bindings/media/i2c/ovti,ov13858.yaml
new file mode 100644
index 0000000000..103ddaad77
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/ovti,ov13858.yaml
@@ -0,0 +1,107 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/ovti,ov13858.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OmniVision OV13858 13 Megapixel CMOS Image Sensor
+
+maintainers:
+  - Tawheed Makhdoomi <_@tawheed.cc>
+
+description:
+  The OmniVision OV13858 is a 1/3-inch 13 megapixel CMOS image sensor with a
+  4-lane MIPI CSI-2 output, controlled over I2C (SCCB). The driver needs a
+  19.2 MHz external clock.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: ovti,ov13858
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: External clock (XVCLK), 19.2 MHz.
+    maxItems: 1
+
+  dovdd-supply:
+    description: Digital I/O voltage supply, 1.8 V.
+
+  avdd-supply:
+    description: Analog voltage supply, 2.8 V.
+
+  dvdd-supply:
+    description: Digital core voltage supply, 1.2 V.
+
+  reset-gpios:
+    description:
+      GPIO connected to the XSHUTDOWN pin, which is physically active low.
+    maxItems: 1
+
+  port:
+    description: MIPI CSI-2 transmitter port
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@10 {
+            compatible = "ovti,ov13858";
+            reg = <0x10>;
+
+            clocks = <&camcc 99>;
+            assigned-clocks = <&camcc 99>;
+            assigned-clock-rates = <19200000>;
+
+            dovdd-supply = <&vreg_l14a_1p8>;
+            avdd-supply = <&vreg_l17a_2p85>;
+            dvdd-supply = <&vreg_l1a_1p2>;
+
+            reset-gpios = <&tlmm 22 GPIO_ACTIVE_LOW>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&csiphy0_ep>;
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <540000000 270000000>;
+                };
+            };
+        };
+    };
+...
