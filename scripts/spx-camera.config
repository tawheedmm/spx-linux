# Surface Pro X (sc8180x) camera support: CAMSS + CCI + sensor drivers.
# Merge on top of the defconfig + spx-cambria.config, for example:
#   scripts/kconfig/merge_config.sh -m arch/arm64/configs/defconfig \
#       $PROJ/scripts/spx-cambria.config $PROJ/scripts/spx-camera.config
#   make olddefconfig
# (camera-wip branch: see docs/workstreams/cameras.md)

# Qualcomm Camera Control Interface (the I2C controller the sensors sit on)
CONFIG_I2C_QCOM_CCI=m
# CAMSS: CSIPHY + CSID + VFE (raw capture through the RDI paths)
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_CAMERA_SENSOR=y
# Sensors: rear OV13858 (ACPI OVTID858), front OV5693, IR OV7251
CONFIG_VIDEO_OV13858=m
CONFIG_VIDEO_OV5693=m
CONFIG_VIDEO_OV7251=m
# Rear module VCM is a Dongwoon DW9800 (driver handles DW9800K); not yet in DT
CONFIG_VIDEO_DW9719=m
# Module EEPROMs (ST M24C64); not yet in DT
CONFIG_EEPROM_AT24=m
# IR emitter: PMIC flash LED channel 1 (LED class + V4L2 flash subdev linked to the OV7251)
CONFIG_LEDS_CLASS_FLASH=m
CONFIG_LEDS_QCOM_FLASH=m
CONFIG_V4L2_FLASH_LED_CLASS=m
