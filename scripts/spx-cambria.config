# Kernel config fragment for Surface Pro X (sc8180x), merged on top of arm64 defconfig.
# Usage: scripts/kconfig/merge_config.sh -m arch/arm64/configs/defconfig spx-cambria.config && make olddefconfig

# --- Early boot / debugging (no reachable UART: use EFI framebuffer + pstore) ---
CONFIG_EFI=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_EFI_VARS_PSTORE=y
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MAGIC_SYSRQ=y

# --- USB Ethernet for the host<->test-device link ---
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y

# --- Storage ---
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_BLK_DEV_NVME=y

# --- Surface Aggregator (keyboard cover, battery, charger, thermals) ---
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SURFACE_PLATFORMS=y
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m
CONFIG_SURFACE_AGGREGATOR_HUB=m
CONFIG_SURFACE_AGGREGATOR_TABLET_SWITCH=m
CONFIG_SURFACE_AGGREGATOR_CDEV=m
CONFIG_SURFACE_DTX=m
CONFIG_SURFACE_PLATFORM_PROFILE=m
CONFIG_SURFACE_HID=m
CONFIG_SURFACE_KBD=m
CONFIG_BATTERY_SURFACE=m
CONFIG_CHARGER_SURFACE=m
CONFIG_SENSORS_SURFACE_TEMP=m

# --- Touch / pen (HID over SPI; userspace iptsd processes the data) ---
CONFIG_SPI_QCOM_GENI=y
CONFIG_SPI_HID=m
# upstream spi-hid v7: core + OF front-end (the Pro X digitizer is a "microsoft,g6-touch-digitizer")
CONFIG_SPI_HID_OF=m
# CONFIG_SPI_HID_ACPI is not set
CONFIG_HID_MULTITOUCH=m
# iptsd reads the digitizer through hidraw and emits contacts/pen via uinput
CONFIG_HIDRAW=y
CONFIG_INPUT_UINPUT=y

# --- Display / GPU ---
CONFIG_DRM_MSM=m
CONFIG_DRM_PANEL_EDP=m
CONFIG_BACKLIGHT_PWM=m
CONFIG_LEDS_QCOM_LPG=m

# --- USB-C ---
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_PMIC_GLINK=m
CONFIG_QCOM_PMIC_GLINK=m

# --- Remote processors, Wi-Fi, Bluetooth, modem ---
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QRTR_MHI=m
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_QCOM_IPA=m

# --- Audio (experimental) ---
CONFIG_SND_SOC_AW88261=m

# --- Audio: Pro X speakers + mics (docs/workstreams/audio.md, branch audio-wip) ---
# Stack: ADSP APR (q6core/q6afe/q6asm/q6adm, NOT AudioReach) -> SLIMbus NGD ->
# WCD9340 codec -> its SoundWire master -> 2x WSA881x amps; sdm845 machine driver.
# All of these are already =m via arm64 defconfig; pinned here so they don't drop out.
CONFIG_SOUND=y
CONFIG_SND=m
CONFIG_SND_SOC=m
CONFIG_QCOM_APR=m
CONFIG_SLIMBUS=m
CONFIG_SLIM_QCOM_NGD_CTRL=m
CONFIG_QCOM_BAM_DMA=y
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_QCOM=m
CONFIG_MFD_WCD934X=m
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_SDM845=m
CONFIG_SND_SOC_WCD934X=m
CONFIG_SND_SOC_WSA881X=m

# --- CPU frequency: build the L3 interconnect in, so cpufreq-hw doesn't defer at boot ---
CONFIG_INTERCONNECT_QCOM_OSM_L3=y

# --- Snaps (Ubuntu's Firefox etc.) need SquashFS + loop devices ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
# desktop snaps (firefox, gnome-*, gtk-common-themes, mesa-*) use LZO; others LZ4; snaps carry xattrs
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_BLK_DEV_LOOP=y

# --- Inputs ---
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y

# Waydroid (Android in an LXC container): binder IPC, PSI for lmkd, and
# NAT for the waydroid0 bridge (Ubuntu's iptables is the nft backend).
# Since 7.x only the Rust binder exists: needs rustc >= 1.85 + bindgen 0.71 (Ubuntu 24.04:
# rustc-1.91, rust-1.91-src, bindgen-0.71, libclang-dev; build-kernel.sh puts them on PATH).
CONFIG_RUST=y
CONFIG_ANDROID_BINDER_IPC_RUST=y
CONFIG_PSI=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=m
# Android (netd) routes everything through policy-routing rules; without these Waydroid has
# no default route ("ip rule": Operation not supported).
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_QUOTA=m
CONFIG_NETFILTER_XT_CONNMARK=m

# ALSA sequencer (MIDI); also keeps alsa-base's "install snd" modprobe hook from failing
CONFIG_SND_SEQUENCER=m
