# Performance fragment (perf-tuning workstream), on top of spx-cambria.config.
# Compressed swap in RAM: none of our kernels had zram, so userspace could not enable it.
# zram needs zsmalloc; with ZRAM=m the kernel only allows ZSMALLOC=m
CONFIG_ZSMALLOC=m
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# Multi-gen LRU: better reclaim decisions under memory pressure, on by default
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
